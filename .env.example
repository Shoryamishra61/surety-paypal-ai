# Server
SURETY_MODE=SIMULATION
HOST=127.0.0.1
PORT=3100
DATABASE_PATH=surety.db

# PayPal sandbox credentials (developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
MERCHANT_RECORDS_PATH=merchant-records.json

# Loopback sandbox mode API tokens (must be distinct)
OPERATOR_TOKEN=
REVIEWER_TOKEN=

# Hosted-demo session credentials (used when HOST is not loopback)
SESSION_SECRET=
DEMO_OPERATOR_PASSWORD=operator-demo
DEMO_REVIEWER_PASSWORD=reviewer-demo

# AI claim extraction — one provider needed. Gemini's free tier is the default.
# Get a key: https://aistudio.google.com/apikey (Gemini) or https://console.groq.com/keys (Groq)
LLM_PROVIDER=
LLM_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
